{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PUKU_CLI_PLUGIN_ROOT}/hooks/herdr-status.sh"
          }
        ]
      }
    ]
  }
}
